# ==============================================================================
# STORE BI - FRONTEND CLIENT ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to '.env' or set these variables in your hosting provider (e.g. Vercel).
# NOTE: Only variables prefixed with VITE_ are exposed to the client-side bundle.
# NEVER place database passwords, service role keys, or OAuth secrets here.
# ==============================================================================

# Backend API Base URL (Do not include trailing slash)
# Local development: http://localhost:8000
# Production deployment: https://api.your-storebi-app.com or https://your-backend-host.com
VITE_API_BASE_URL=http://localhost:8000

# Optional Google OAuth Client ID for Google Identity Services prompt (GIS)
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
