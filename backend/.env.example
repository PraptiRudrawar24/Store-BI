# ==============================================================================
# STORE BI - BACKEND PRODUCTION CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to '.env' and fill in your actual production/staging values.
# NEVER commit the active '.env' file containing real secrets to source control.
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=production
PORT=8000
FRONTEND_URL=https://your-storebi-app.com

# --- Database Connection ---
# For local SQLite: sqlite:///./store_bi.db
# For production PostgreSQL: postgresql://username:password@db-host:5432/storebi
DATABASE_URL=sqlite:///./store_bi.db

# --- Security & JWT Sessions ---
# Generate a high-entropy secret using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-production-high-entropy-jwt-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7
COOKIE_NAME=store_bi_session
COOKIE_SECURE=true
# Set COOKIE_DOMAIN if serving frontend & backend across subdomains (e.g., .yourdomain.com)
# COOKIE_DOMAIN=.yourdomain.com

# --- Super Administrator Configuration ---
# Any user registering or logging in with this email is automatically granted Platform Admin rights.
ADMIN_EMAIL=admin@storebi.com

# --- Google OAuth 2.0 Credentials ---
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI: https://your-storebi-app.com/auth/google/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://your-storebi-app.com/auth/google/callback

# --- Email Delivery Configuration ---
# Enforce email verification before dashboard access (set to false for local zero-email dev)
REQUIRE_EMAIL_VERIFICATION=true

# Option A: Standard SMTP Delivery (e.g. Amazon SES, Postmark, Mailgun, Brevo, Gmail SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_password_or_api_key
SMTP_FROM_EMAIL=notifications@storebi.com
SMTP_FROM_NAME=Store BI Intelligence
SMTP_SECURE=false

# Option B: Resend REST API (If using Resend instead of SMTP, specify RESEND_API_KEY)
# RESEND_API_KEY=re_123456789_abcdefg

# --- Multimodal Vision & OCR AI ---
# Google Gemini API key for smart invoice scanning & handwritten receipts
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-google-gemini-api-key
